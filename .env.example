# ==========================================
# DisHost & Vercel 공통 환경변수 (Environment Variables)
# ==========================================

# 1. 디스코드 봇 설정 (DisHost 전용)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

# 2. 관리자 웹 패널 설정 (Vercel & DisHost 공통)
ADMIN_PASSWORD=admin1234
SESSION_SECRET=your_random_secret_session_key
PORT=3000

# 3. 데이터베이스 설정 (MongoDB Atlas 클라우드 - Vercel & DisHost 필수 연동)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/simulation_db?retryWrites=true&w=majority
